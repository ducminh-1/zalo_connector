<odoo>
<!-- Automation -->
    <record id="zalo_oa_trigger_pos" model="base.automation">
        <field name="name">Action Create ZNS Template POS Order</field>
        <field name="active">True</field>
        <field name="trigger">on_write</field>
        <field name="filter_pre_domain">[('state', '=', 'draft')]</field>
        <field name="filter_domain">[('state', '=', 'paid')]</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="trigger_field_ids" eval="[(4,ref('point_of_sale.field_pos_order__state'))]"/>
        <field name="on_change_fields">state</field>
        <field name="state">code</field>
        <field name="code">
if record.state == 'paid' and record.partner_id:
    env['send.zns.template'].sudo().create_zns_template(order_id=record.id)
        </field>
    </record>

