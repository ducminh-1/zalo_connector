<!-- Resend Faield Zalo Send Messages -->
    <record id="action_resend_failed_send_messages" model="ir.actions.server">
        <field name="name">Resend Send Messages</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="model_zns_messages" />
        <field name="binding_model_id" ref="model_zns_messages"/>
        <field name="binding_view_types">list</field>
        <field name="code">records.send_zns_template()</field>
    </record>
