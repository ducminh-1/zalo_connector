<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zns_template_message_view_form" model="ir.ui.view">
        <field name="name">zns.messages.view.form</field>
        <field name="model">zns.messages</field>
        <field name="arch" type="xml">
            <form string="Messages">
                <header>
                    <button name="send_zns_template" type="object" string="Send Message" class="oe_highlight" 
                            attrs="{'invisible': [('state', 'in', ['sent', 'error', 'canceled'])]}"/>
                    <button name="action_set_canceled" type="object" string="Cancel" class="btn-secondary"
                            attrs="{'invisible': [('state', '=', 'canceled')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="body"/>
                        </group>
                        <group>
                            <field name="number"/>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="zns" string="ZNS Value">
                            <field name='zns_template_val_ids' readonly="1">
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="value"/>
                                        </group>
                                    </sheet>
                                </form>
                                <tree>
                                    <field name="name"/>         
                                    <field name="value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div> 
                </sheet>
            </form>
        </field>
    </record>

    <record id="zns_template_message_view_tree" model="ir.ui.view">
        <field name="name">zns.messages.view.tree</field>
        <field name="model">zns.messages</field>
        <field name="arch" type="xml">
            <tree create="false" delete="true" decoration-danger="state == 'error'" decoration-muted="state == 'sent'">
                <field name="body"/>
                <field name="number"/>
                <field name="date_exec"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="zns_template_message_action" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">zns.messages</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="zns_template_message_menu"
        parent="zalo_configuration_menu"
        action="zns_template_message_action"
        sequence="1"/>
</odoo>