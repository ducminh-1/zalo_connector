<?xml version="1.0"?>
<odoo>
    <record id="view_form_send_zns_template" model="ir.ui.view">
        <field name="name">send.zns.template.form</field>
        <field name="model">send.zns.template</field>
        <field name="arch" type="xml">
            <form string="Send ZNS Template">
                <group>
                    <field name="partner_id"/>
                    <field name="zalo_oa_id"/>
                    <field name="zns_rating_template_id" domain="[('zalo_oa_id', '=', zalo_oa_id)]"/>
                </group>
                <footer>
                    <button string="Create ZNS Template" type="object" name="create_zns_template" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="send_zns_template_action" model="ir.actions.act_window">
        <field name="name">Create ZNS Template When Confirm Order</field>
        <field name="res_model">send.zns.template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_res_model': active_model, 'default_res_id': active_id, 'default_partner_id': partner_id}</field>
    </record>
</odoo>